# Copiez ce fichier en .env et complétez les valeurs avant de lancer l'app.

# --- Base de données ---
# SQLite en local (zéro config). En production, préférez PostgreSQL : voir
# le README ("Passer en production") pour la marche à suivre.
DATABASE_URL="file:./dev.db"

# --- Authentification ---
# Secret utilisé pour signer les sessions (JWT). Générez une valeur aléatoire
# forte, ex : `openssl rand -base64 32`. Obligatoire en production.
AUTH_SECRET=""

# URL publique du site (utilisée pour les redirections Stripe, etc.)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Stripe (paiements web) ---
# Clé secrète de votre compte Stripe (tableau de bord Stripe > Développeurs > Clés API)
STRIPE_SECRET_KEY=""
# Secret de signature du webhook (Stripe CLI en local : `stripe listen --print-secret`,
# ou tableau de bord Stripe > Webhooks en production)
STRIPE_WEBHOOK_SECRET=""

# --- Apple (achats intégrés iOS, app mobile uniquement) ---
# Identifiant de bundle de l'app iOS (doit correspondre à App Store Connect)
APPLE_BUNDLE_ID="com.astrologia.app"
# "Sandbox" en développement/TestFlight, "Production" une fois publié
APPLE_ENVIRONMENT="Sandbox"
# Dossier contenant les certificats racine Apple (.cer, DER) téléchargés sur
# https://www.apple.com/certificateauthority/ — nécessaires pour vérifier les
# reçus StoreKit. Fichiers binaires à télécharger vous-même, non fournis.
APPLE_ROOT_CERTS_DIR="./apple-certs"
# Pour appeler l'App Store Server API (App Store Connect > Utilisateurs et accès > Intégrations)
APPLE_KEY_ID=""
APPLE_ISSUER_ID=""
# Clé privée .p8 téléchargée depuis App Store Connect, contenu complet du fichier
APPLE_PRIVATE_KEY=""

# --- Capacitor (app iOS) ---
# URL du site que l'app mobile charge dans sa coque native
CAPACITOR_SERVER_URL="https://app.astrologia.example"
